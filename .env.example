# MongoDB Atlas connection string. Use a database user with least-privilege access.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/aster-workspace?retryWrites=true&w=majority
# Generate a long random secret (at least 32 characters).
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# Set to production on Vercel; Vercel sets NODE_ENV automatically.
NODE_ENV=development
